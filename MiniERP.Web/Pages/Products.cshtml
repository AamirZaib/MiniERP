@* Pages/Products.cshtml *@
@page
@model MiniERP.Web.Pages.ProductsModel
@{
    ViewData["Title"] = "Products";
}

<div class="page-header">
    <h1>Products</h1>
</div>

<div class="stat-row">
    <div class="stat-card">
        <div class="stat-label">Total Products</div>
        <div class="stat-value">@Model.Products.Count</div>
    </div>
    <div class="stat-card warn">
        <div class="stat-label">Low Stock Items</div>
        <div class="stat-value">@Model.Products.Count(p => p.IsLowStock)</div>
    </div>
    <div class="stat-card success">
        <div class="stat-label">Inventory Value</div>
        <div class="stat-value">Rs. @Model.Products.Sum(p => p.Price * p.StockQuantity).ToString("N0")</div>
    </div>
</div>
<form method="post" asp-page-handler="Search" style="margin-bottom: 20px; display: flex; gap: 10px;">
    <input name="SearchQuery" class="form-control" placeholder="Try: 'cheap electronics with low stock'" style="flex: 1;" />
    <button type="submit" class="btn-gold">AI Search</button>
</form>

@if (Model.AiExplanation != null)
{
    <div class="ai-insight-box">
        <div class="ai-insight-icon">🤖</div>
        <div class="ai-insight-content">
            <div class="ai-insight-label">AI Insight</div>
            <div class="ai-insight-text">@Model.AiExplanation</div>
        </div>
    </div>
}

<div class="page-header">
    <h1>Products</h1>
    <a href="/CreateProduct" class="btn-gold" style="text-decoration: none;">+ Add Product</a>
</div>

<table class="data-table">
    <thead>
        <tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Action</th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            <tr>
                <td style="font-weight: 500;">@p.Name</td>
                <td style="color: var(--text-muted);">@p.CategoryName</td>
                <td>Rs. @p.Price.ToString("N0")</td>
                <td>@p.StockQuantity</td>
                <td>
                    @if (p.IsLowStock)
                    {
                        <span class="badge-status badge-warn">Low Stock</span>
                    }
                    else
                    {
                        <span class="badge-status badge-ok">In Stock</span>
                    }
                </td>
                <td><a href="/EditProduct/@p.Id" class="btn-gold" style="padding: 4px 12px; font-size: 13px; text-decoration: none; display: inline-block;">Edit</a></td>
            </tr>
        }
    </tbody>
</table>