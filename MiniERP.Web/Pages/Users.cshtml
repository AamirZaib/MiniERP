@page
@model MiniERP.Web.Pages.UsersModel
@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <h1>Users</h1>
</div>

<div class="form-card">
    <div class="form-label" style="margin-bottom: 12px;">Create New User (Admin only)</div>
    <form method="post">
        <div class="mb-3">
            <div class="form-label">Full Name</div>
            <input asp-for="NewUser.FullName" class="form-control w-100" />
        </div>
        <div class="mb-3">
            <div class="form-label">Email</div>
            <input asp-for="NewUser.Email" class="form-control w-100" />
        </div>
        <div class="mb-3">
            <div class="form-label">Password</div>
            <input asp-for="NewUser.Password" type="password" class="form-control w-100" />
        </div>
        <div class="mb-3">
            <div class="form-label">Role</div>
            <select asp-for="NewUser.Role" class="form-control w-100">
                <option value="Admin">Admin</option>
                <option value="Sales">Sales</option>
                <option value="WarehouseStaff">Warehouse Staff</option>
            </select>
        </div>
        <button type="submit" class="btn-gold w-100">Create User</button>
    </form>

    @if (Model.Message != null)
    {
        <p style="margin-top: 12px; font-size: 14px; color: @(Model.Success ? "var(--success)" : "var(--danger)");">@Model.Message</p>
    }
</div>