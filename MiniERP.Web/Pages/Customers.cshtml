@* Pages/Customers.cshtml *@
@page
@model MiniERP.Web.Pages.CustomersModel
@{
    ViewData["Title"] = "Customers";
}

<div class="page-header">
    <h1>Customers</h1>
</div>

<div style="display: flex; gap: 24px; flex-wrap: wrap;">
    <div style="flex: 2; min-width: 300px;">
        <table class="data-table">
            <thead><tr><th>Name</th><th>Email</th><th>Phone</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr><td>@c.Name</td><td>@c.Email</td><td>@(c.Phone ?? "—")</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div style="flex: 1; min-width: 260px;">
        <div class="form-card">
            <div class="form-label" style="margin-bottom: 12px;">Add New Customer</div>
            <form method="post">
                <input asp-for="NewCustomer.Name" class="form-control w-100 mb-3" placeholder="Full name" />
                <input asp-for="NewCustomer.Email" class="form-control w-100 mb-3" placeholder="Email" />
                <input asp-for="NewCustomer.Phone" class="form-control w-100 mb-3" placeholder="Phone (optional)" />
                <button type="submit" class="btn-gold w-100">Add Customer</button>
            </form>
            @if (Model.ErrorMessage != null)
            {
                <p style="color: var(--danger); font-size: 13px; margin-top: 10px;">@Model.ErrorMessage</p>
            }
        </div>
    </div>
</div>