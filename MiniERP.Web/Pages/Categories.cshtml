@* Pages/Categories.cshtml *@
@page
@model MiniERP.Web.Pages.CategoriesModel
@{
    ViewData["Title"] = "Categories";
}

<div class="page-header">
    <h1>Categories</h1>
</div>

<div style="display: flex; gap: 24px; flex-wrap: wrap;">
    <div style="flex: 2; min-width: 300px;">
        <table class="data-table">
            <thead><tr><th>Id</th><th>Name</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr><td>@c.Id</td><td>@c.Name</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div style="flex: 1; min-width: 260px;">
        <div class="form-card">
            <div class="form-label" style="margin-bottom: 12px;">Add New Category</div>
            <form method="post">
                <input asp-for="NewCategoryName" class="form-control w-100 mb-3" placeholder="Category name" />
                <button type="submit" class="btn-gold w-100">Add Category</button>
            </form>
            @if (Model.ErrorMessage != null)
            {
                <p style="color: var(--danger); font-size: 13px; margin-top: 10px;">@Model.ErrorMessage</p>
            }
        </div>
    </div>
</div>