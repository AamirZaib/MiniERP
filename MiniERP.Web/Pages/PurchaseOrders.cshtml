@* Pages/PurchaseOrders.cshtml *@
@page
@model MiniERP.Web.Pages.PurchaseOrdersModel
@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="page-header">
    <h1>Purchase Orders</h1>
</div>

<div class="form-card" style="margin-bottom: 28px;">
    <div class="form-label" style="margin-bottom: 12px;">Create New Purchase Order</div>
    <form method="post" asp-page-handler="Create">
        <div class="mb-3">
            <div class="form-label">Supplier</div>
            <select asp-for="SupplierId" asp-items="Model.SupplierOptions" class="form-control w-100">
                <option value="">-- Select supplier --</option>
            </select>
        </div>
        <div class="mb-3">
            <div class="form-label">Product</div>
            <select asp-for="ProductId" asp-items="Model.ProductOptions" class="form-control w-100">
                <option value="">-- Select product --</option>
            </select>
        </div>
        <div style="display: flex; gap: 12px;">
            <div class="mb-3" style="flex: 1;">
                <div class="form-label">Quantity</div>
                <input asp-for="Quantity" class="form-control w-100" />
            </div>
            <div class="mb-3" style="flex: 1;">
                <div class="form-label">Unit Cost (Rs.)</div>
                <input asp-for="UnitCost" class="form-control w-100" />
            </div>
        </div>
        <button type="submit" class="btn-gold w-100 mt-2">Create Purchase Order</button>
    </form>

    @if (Model.ResultMessage != null)
    {
        <div style="margin-top: 16px; padding: 12px 16px; border-radius: 4px; font-size: 14px;
            background: @(Model.Success ? "#E2F4EC" : "#FBE7E7");
            color: @(Model.Success ? "#1B7A4F" : "#A32C2C");">
            @Model.ResultMessage
        </div>
    }
</div>

<table class="data-table">
    <thead>
        <tr><th>PO #</th><th>Supplier</th><th>Status</th><th>Total</th><th>Date</th><th>Action</th></tr>
    </thead>
    <tbody>
        @foreach (var po in Model.PurchaseOrders)
        {
            <tr>
                <td>#@po.Id</td>
                <td>@po.SupplierName</td>
                <td>
                    @if (po.Status == "Received")
                    {
                        <span class="badge-status badge-ok">Received</span>
                    }
                    else
                    {
                        <span class="badge-status badge-warn">@po.Status</span>
                    }
                </td>
                <td>Rs. @po.TotalAmount.ToString("N0")</td>
                <td>@po.OrderDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (po.Status != "Received")
                    {
                        <form method="post" asp-page-handler="Receive" asp-route-id="@po.Id" style="display:inline;">
                            <button type="submit" class="btn-gold" style="padding: 4px 12px; font-size: 13px;">Mark Received</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>